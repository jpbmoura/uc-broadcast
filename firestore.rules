rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ---------- data ----------
    function incoming() {           
      return request.resource.data;
    }

    function existing() {          
      return resource.data;
    }

    // ---------- isOwner ----------
    function owns(data) {
      return signedIn() && data.tenantId == uid();
    }

    function ownsConnection(connectionId) {
      let path = /databases/$(database)/documents/connections/$(connectionId);
      return exists(path) && get(path).data.tenantId == uid();
    }

    // ---------- format ----------
    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }

    function onlyChanged(fields) {
      return incoming().diff(existing()).affectedKeys().hasOnly(fields);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isPhone(value) {
      return value is string && value.matches('^[+][1-9][0-9]{7,14}$');
    }

    function isNewTimestamps() {
      return incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    function isRecipients(value) {
      return value is list && value.size() >= 1 && value.size() <= 500;
    }

    match /connections/{connectionId} {
      allow read: if owns(existing());

      allow create: if owns(incoming())
        && hasExactly(['tenantId', 'name', 'createdAt', 'updatedAt'])
        && isText(incoming().name, 1, 80)
        && isNewTimestamps();

      allow update: if owns(existing())
        && onlyChanged(['name', 'updatedAt'])
        && isText(incoming().name, 1, 80)
        && incoming().updatedAt == request.time;

      allow delete: if owns(existing());
    }

    match /contacts/{contactId} {
      allow read: if owns(existing());

      allow create: if owns(incoming())
        && hasExactly(['tenantId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && ownsConnection(incoming().connectionId)
        && isText(incoming().name, 1, 80)
        && isPhone(incoming().phone)
        && isNewTimestamps();

      allow update: if owns(existing())
        && onlyChanged(['name', 'phone', 'updatedAt'])
        && isText(incoming().name, 1, 80)
        && isPhone(incoming().phone)
        && incoming().updatedAt == request.time;

      allow delete: if owns(existing());
    }

    match /messages/{messageId} {
      allow read: if owns(existing());

      allow create: if owns(incoming())
        && hasExactly(['tenantId', 'connectionId', 'body', 'recipients', 'status',
                         'scheduledAt', 'sentAt', 'createdAt', 'updatedAt'])
        && ownsConnection(incoming().connectionId)
        && isText(incoming().body, 1, 4096)
        && isRecipients(incoming().recipients)
        && incoming().status == 'scheduled'
        && incoming().sentAt == null
        && incoming().scheduledAt is timestamp
        && isNewTimestamps();

      allow update: if owns(existing())
        && existing().status == 'scheduled'
        && onlyChanged(['body', 'recipients', 'scheduledAt', 'updatedAt'])
        && isText(incoming().body, 1, 4096)
        && isRecipients(incoming().recipients)
        && incoming().scheduledAt is timestamp
        && incoming().updatedAt == request.time;

      allow delete: if owns(existing());
    }
  }
}
